      ],
      "reduction_goal": "represent connectivity as disjoint-set representatives",
      "reasoning_operator": "MERGE_COMPONENTS + REPRESENTATIVE_QUERY"
    },
    {
      "id": "grid_shortest_walk",
      "triggers": [
        "grid",
        "maze",
        "minimum steps",
        "fewest moves"
      ],
      "inferred_concepts": [
        "implicit graph",
        "uniform edge cost",
        "neighbor expansion"
      ],
      "reduction_goal": "turn cells into graph states and search breadth-first",
      "reasoning_operator": "GRID_TO_GRAPH + BFS_LAYERING"
    },
    {
      "id": "monotone_answer_search",
      "triggers": [
        "minimum possible",
        "maximum possible",
        "maximize the minimum",
        "minimize the maximum",
        "monotone"
      ],
      "inferred_concepts": [
