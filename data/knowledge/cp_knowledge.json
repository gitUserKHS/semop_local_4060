      "reduction_goal": "reduce repeated interval questions into reusable aggregates",
      "reasoning_operator": "PRECOMPUTE + RANGE_DECOMPOSE"
    },
    {
      "id": "dynamic_range_aggregation",
      "triggers": [
        "point update",
        "range query",
        "dynamic sum queries",
        "change and query"
      ],
      "inferred_concepts": [
        "online updates",
        "logarithmic maintenance",
        "range decomposition"
      ],
      "reduction_goal": "maintain an aggregate under updates and queries",
      "reasoning_operator": "UPDATE_PROPAGATE + RANGE_QUERY"
    },
    {
      "id": "dynamic_connectivity",
      "triggers": [
        "union find",
        "same component",
        "connectivity queries",
        "merge sets"
      ],
      "inferred_concepts": [
        "equivalence classes",
        "component representative",
