  "logical_frames": [
    {
      "id": "single_source_shortest_path",
      "triggers": [
        "weighted graph",
        "shortest path",
        "from city 1",
        "roads",
        "travel time"
      ],
      "inferred_concepts": [
        "source fixed at one node",
        "distance relaxation",
        "priority-driven frontier"
      ],
      "reduction_goal": "reduce the statement into a graph shortest-path state space",
      "reasoning_operator": "STATE_GRAPH + NONNEGATIVE_COST + FRONTIER_MINIMIZE"
    },
    {
      "id": "offline_range_aggregation",
      "triggers": [
        "range sum",
        "sum from l to r",
        "many queries",
        "interval sum"
      ],
      "inferred_concepts": [
        "query repetition",
